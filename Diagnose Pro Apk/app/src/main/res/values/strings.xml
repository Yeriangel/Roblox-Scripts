    <!-- Clear codes -->
    <string name="clear_title">Clear fault codes?</string>
    <string name="clear_text_engine">• The engine should be OFF with the ignition ON (some cars need the engine idling).</string>
    <string name="clear_text_not_fix">• Clearing does NOT fix the problem. If the fault is still there, the code and the light will come back — sometimes after a few minutes, sometimes after a few drives.</string>
    <string name="clear_text_monitors">• Clearing also resets the readiness monitors and freeze frame data. The car may fail an emissions / annual inspection until it has been driven enough for the monitors to be ready again.</string>
    <string name="clear_text_saved">The current codes will be saved to History first.</string>
    <string name="clear_continue">Continue</string>
    <string name="clear_confirm_title">Final confirmation</string>
    <string name="clear_confirm_text">Send the clear command (Mode 04) to the car now?</string>
    <string name="clear_confirm_button">I understand, clear codes</string>
