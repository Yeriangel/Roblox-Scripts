    <string name="error_hint_not_elm">בחרו מכשיר אחר מהרשימה, או נתקו וחברו מחדש את המתאם.</string>
    <string name="error_hint_no_vehicle">העבירו את ההצתה למצב ON (או התניעו) ונסו שוב. רכבים ישנים מאוד (לפני 2001 באירופה / 1996 בארה״ב) לא תמיד תומכים ב-OBD2.</string>
    <string name="error_hint_bus_error">כבו את ההצתה והדליקו שוב, ואז התחברו מחדש. אם זה חוזר, ייתכן שהמתאם לא תומך בפרוטוקול של הרכב.</string>
    <string name="error_hint_link_lost">ודאו שהמתאם עדיין מחובר ושהטלפון קרוב לרכב.</string>
    <string name="error_hint_unknown">נסו שוב. אם זה חוזר, הפעילו את קונסולת המפתחים בהגדרות כדי לראות פרטים.</string>

    <string name="clone_warning_title">ייתכן שהמתאם הוא חיקוי</string>
    <string name="clone_warning_text">המתאם שלכם נראה כמו חיקוי זול של ELM327 (%1$s). רוב התכונות בדרך כלל עובדות, אבל הקריאה עלולה להיות איטית יותר וחלק מהפקודות עלולות להיכשל.</string>

    <!-- Onboarding -->
    <string name="onb_title_1">חברו את המתאם</string>
    <string name="onb_text_1">מצאו את שקע ה-OBD2 מתחת להגה (ליד הדוושות) וחברו אליו את מתאם ה-ELM327. אחר כך העבירו את ההצתה למצב ON או התניעו את המנוע.</string>
    <string name="onb_title_2">צמדו אותו לטלפון</string>
    <string name="onb_text_2">פתחו את הגדרות הבלוטות׳ בטלפון וצמדו את המתאם. השם שלו בדרך כלל OBDII,‏ ELM327 או V-LINK. הקוד הנפוץ הוא 1234 או 0000. (מתאמי BLE לא צריכים צימוד.)</string>
    <string name="onb_title_3">התחברו באפליקציה</string>
    <string name="onb_text_3">הקישו על מצב החיבור בראש המסך, בחרו את המתאם וזהו. עוד אין לכם מתאם? נסו את מצב ההדגמה כדי להכיר את כל המסכים.</string>
    <string name="onb_get_started">בואו נתחיל</string>
    <string name="limits_note">OBD2 גנרי קורא את מערכות המנוע והפליטה. מערכות ABS, כריות אוויר ותיבת הילוכים דורשות בדרך כלל כלים ייעודיים ליצרן.</string>

    <!-- Permissions / Bluetooth -->
    <string name="perm_title">גישה לבלוטות׳</string>
    <string name="perm_text">דיאגנוז פרו משתמשת בבלוטות׳ רק כדי לדבר עם מתאם ה-OBD. האפליקציה לא משתמשת במיקום שלכם ולא שולחת שום מידע לאינטרנט.</string>
    <string name="perm_text_legacy">בגרסת אנדרואיד הזו, חיפוש מכשירי בלוטות׳ דורש הרשאת מיקום. האפליקציה לא משתמשת במיקום ולא שומרת אותו.</string>
    <string name="perm_grant">אישור</string>
    <string name="perm_denied_forever">ההרשאה נדחתה. פתחו את הגדרות האפליקציה ואשרו \"מכשירים בקרבת מקום\" (או מיקום בטלפונים ישנים).</string>
